{
  "name": "parkside-activities-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k --kill-signal SIGKILL -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "dotnet watch --project ../Parkside.Api --non-interactive",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "lefthook": "^2.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
